{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BA3 Runner",
  "mainBinaryName": "ba3-runner",
  "version": "0.1.0",
  "identifier": "com.franklinchen.ba3-runner",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420/process",
    "beforeBuildCommand": "bash ../../scripts/generate_dashboard_api_types.sh && npm --prefix ../../frontend run build",
    "frontendDist": "../../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BA3 Runner",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": "all"
  }
}
