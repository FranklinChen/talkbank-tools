{
  "name": "batchalign-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:schema": "cd .. && cargo run -q -p batchalign -- openapi --output frontend/openapi.json",
    "generate:types": "npm run generate:schema && openapi-typesafe openapi.json -o src/generated/api.ts && npm run generate:decoders",
    "check:api": "bash ../scripts/check_dashboard_api_drift.sh",
    "build": "npm run typecheck && vite build",
    "build:deploy": "bash ../scripts/build_react_dashboard.sh",
    "e2e:install": "npm --prefix e2e ci",
    "e2e:browsers": "npm --prefix e2e run install:browsers",
    "e2e:setup": "npm run e2e:install && npm run e2e:browsers",
    "test:e2e": "npm --prefix e2e run test --",
    "test:e2e:headed": "npm --prefix e2e run test:headed --",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "generate:decoders": "node scripts/generate-decoders.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "effect": "4.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@effect/vitest": "4.1.4",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "openapi-typesafe": "1.0.0-rc.13",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
