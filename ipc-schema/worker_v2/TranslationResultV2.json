{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranslationResultV2",
  "description": "Batched translation response payload.",
  "type": "object",
  "properties": {
    "items": {
      "description": "Item results aligned to the prepared batch payload order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/TranslationItemResultV2"
      }
    }
  },
  "required": [
    "items"
  ],
  "$defs": {
    "HttpStatusCodeV2": {
      "description": "An HTTP status code as a provider answered it: 100 to 599.",
      "type": "integer",
      "format": "uint16",
      "maximum": 599,
      "minimum": 100
    },
    "NonNegativeSeconds": {
      "description": "A finite, non-negative number of seconds.",
      "type": "number",
      "format": "double",
      "minimum": 0.0
    },
    "ReportedEngineName": {
      "description": "An engine identity as a worker reported it, written into cache namespaces and provenance fields byte for byte: not blank, no surrounding whitespace, and none of `|`, `;`, `]` or a line break.",
      "type": "string",
      "pattern": "^[^\\u0009\\u000A\\u000B\\u000C\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007\\u2008\\u2009\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\u007C\\u003B\\u005D\\u000A\\u000D](?:[^\\u007C\\u003B\\u005D\\u000A\\u000D]*[^\\u0009\\u000A\\u000B\\u000C\\u000D\\u0020\\u0085\\u00A0\\u1680\\u2000\\u2001\\u2002\\u2003\\u2004\\u2005\\u2006\\u2007\\u2008\\u2009\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\u007C\\u003B\\u005D\\u000A\\u000D])?$"
    },
    "TranslationItemResultV2": {
      "description": "One translation item result returned by Python.\n\nA tagged union: a translation always names the engine that produced it,\nand a failure says what kind it was. The worker reports and never retries:\nwhether a provider's answer is waited out is decided by the control plane\n(`batchalign::translate::provider`), where the wait is visible to the\njob's deadline and cancellation.",
      "oneOf": [
        {
          "description": "The engine translated the item.",
          "type": "object",
          "properties": {
            "engine": {
              "description": "The translation engine that produced it.",
              "$ref": "#/$defs/ReportedEngineName"
            },
            "kind": {
              "type": "string",
              "const": "translated"
            },
            "raw_translation": {
              "description": "Raw model translation.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "raw_translation",
            "engine"
          ]
        },
        {
          "description": "The item's text was blank, so no engine ran.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "blank_input"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "The provider answered with an HTTP status instead of a translation.",
          "type": "object",
          "properties": {
            "error": {
              "description": "The provider library's own message, for the operator.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "provider_status"
            },
            "retry_after_s": {
              "description": "The cooldown the provider asked for (`Retry-After`), when it named\none in seconds.",
              "anyOf": [
                {
                  "$ref": "#/$defs/NonNegativeSeconds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "description": "The status the provider answered.",
              "$ref": "#/$defs/HttpStatusCodeV2"
            }
          },
          "required": [
            "kind",
            "status",
            "error"
          ]
        },
        {
          "description": "The request reached no provider answer: a transport failure before\nany reply.",
          "type": "object",
          "properties": {
            "error": {
              "description": "The transport error, rendered.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "no_response"
            }
          },
          "required": [
            "kind",
            "error"
          ]
        },
        {
          "description": "The engine failed the item with no provider semantics; the verdict is\nfinal and the file it belongs to fails with this message.",
          "type": "object",
          "properties": {
            "error": {
              "description": "Operator-facing failure message.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "kind",
            "error"
          ]
        }
      ]
    }
  }
}