{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhisperDecodeLanguageV2",
  "description": "How a stock Whisper worker is told its language.",
  "oneOf": [
    {
      "description": "Whisper detects the language itself.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "detect"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "description": "Whisper decodes in this language and transcribes (never translates).",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "force"
        },
        "token": {
          "description": "Whisper's own token for the language.",
          "$ref": "#/$defs/WhisperLanguageToken"
        }
      },
      "required": [
        "kind",
        "token"
      ]
    }
  ],
